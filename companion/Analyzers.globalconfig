is_global = true

# Every analyser rule that is on by default but reports below a warning (info or hidden) reports a warning.
# A rule the shared .editorconfig configures keeps that setting, because .editorconfig takes precedence.
# Bulk entries (dotnet_analyzer_diagnostic.severity) do nothing here: AnalysisLevel latest-all ignores them, so each rule is listed.

# MA0127 wants string.Equals in place of an is pattern, against the C# style rule "patterns for every comparison with a constant".
dotnet_diagnostic.MA0127.severity = silent

# IDE0010 is a .NET rule and wins over Roslynator RCS1069, RCS1070 and RCS1136: a switch statement ends in a default section that throws.
dotnet_diagnostic.IDE0010.severity = warning

