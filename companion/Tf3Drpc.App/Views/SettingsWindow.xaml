<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="Tf3Drpc.App.Views.SettingsWindow"
    x:ClassModifier="Internal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:constants="clr-namespace:Tf3Drpc.App.Constants"
    xmlns:asm="clr-namespace:"
    Title="{x:Static constants:AppConstants.ApplicationName}"
    Width="{x:Static constants:AppConstants.SettingsWindowWidth}"
    Height="{x:Static constants:AppConstants.SettingsWindowHeight}"
    MinimumWidth="{x:Static constants:AppConstants.SettingsWindowMinimumWidth}"
    MinimumHeight="{x:Static constants:AppConstants.SettingsWindowMinimumHeight}">
    <Window.TitleBar>
        <!-- macOS keeps its native title bar; MacWindowService adds the version as its subtitle. -->
        <OnPlatform x:TypeArguments="TitleBar">
            <On Platform="WinUI">
                <TitleBar
                    Title="{x:Static constants:AppConstants.ApplicationName}"
                    HeightRequest="48"
                    Icon="tray.ico"
                    Subtitle="{x:Static asm:ThisAssembly+Info.InformationalVersion}" />
            </On>
        </OnPlatform>
    </Window.TitleBar>
</Window>
